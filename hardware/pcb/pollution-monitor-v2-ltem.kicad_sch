  (text "MAPA DE PINES ADICIONALES (v2 LTE-M):" (at 115 65 0) (effects (font (size 1.524 1.524) (bold yes))))

  (text "GPIO7  -> SIM7080G TXD (ESP32 → modulo, UART1)\nGPIO10 -> SIM7080G RXD (modulo → ESP32, UART1)\nGPIO11 -> PWRKEY (pulso LOW >1.2s para encender)\nGPIO18 -> STATUS (HIGH = encendido, LOW = apagado)" (at 115 68 0) (effects (font (size 1.27 1.27))))

  (text "CAMBIOS RESPECTO A v1:\n- U6: SIM7080G-M2M (LTE-M + NB-IoT + GNSS)\n- U7: AMS1117-3.8V (LDO dedicado para celular)\n- C11: 470uF bulk cap (absorbe picos TX celular ~500mA)\n- J5: Nano-SIM holder (borde placa)\n- D2: LED azul NETLIGHT (estado de red)\n- D3: PRTR5V0U2X (ESD en lineas SIM)\n- Tamano PCB: 80x60mm (vs 70x55mm v1)" (at 115 78 0) (effects (font (size 1.27 1.27))))

