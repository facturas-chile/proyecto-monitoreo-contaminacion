  ;; =====================================================
  ;; NOTAS DEL ESQUEMATICO
  ;; =====================================================

  (text "MAPA DE PINES ESP32-C3-MINI-1:" (at 245 40.64 0) (effects (font (size 1.524 1.524) (bold yes))))

  (text "GPIO2  -> PPD42 Vout (pulsos digitales)\nGPIO3  -> MQ-2 AOUT (ADC1_CH3, tras divisor volt)\nGPIO4  -> I2S WS (microfono ICS-43434)\nGPIO5  -> I2S SCK\nGPIO6  -> I2S SD\nGPIO8  -> I2C SDA (SHT31 + BH1750)\nGPIO9  -> I2C SCL\nGPIO20 -> UART RXD0 (debug)\nGPIO21 -> UART TXD0\nEN     -> Reset (SW1, pull-up 10k)\nGPIO9  -> Boot (SW2, pull-up 10k)" (at 245 43.18 0) (effects (font (size 1.27 1.27))))

  (text "NOTA DE DISENO:\n- SHT31 ADDR=GND -> dir I2C 0x44\n- BH1750 ADDR=GND -> dir I2C 0x23\n- ICS-43434 L/R=GND -> canal izquierdo\n- MQ-2 necesita precalentamiento 30s\n- PPD42 consume 5V@90mA (alimentar desde VBUS USB-C)\n- Tamano objetivo PCB: 70x55mm, 2 capas\n- Fabricar en JLCPCB: Gerber + BOM LCSC -> PCBA" (at 245 88.9 0) (effects (font (size 1.27 1.27))))

)
